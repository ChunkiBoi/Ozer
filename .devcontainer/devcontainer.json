{
  "name": "ozer",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "nodeGypDependencies": true
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "alexcvzz.vscode-sqlite",
        "ms-toolsai.jupyter",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "files.autoSave": "afterDelay",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  },
  "forwardPorts": [
    5000,
    8080
  ],
  "portsAttributes": {
    "5000": {
      "label": "Flask App",
      "onAutoForward": "openPreview"
    },
    "8080": {
      "label": "SQLite Web GUI",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "bash -lc 'sudo apt-get update && sudo apt-get install -y sqlite3 git-lfs && git lfs install && python -m pip install --upgrade pip && python -m pip install -r requirements.txt && npm install'",
  "remoteUser": "vscode"
}