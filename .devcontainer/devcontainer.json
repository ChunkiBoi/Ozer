{
  "name": "Python/Flask Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "alexcvzz.vscode-sqlite",
        "ms-toolsai.jupyter",
        "esbenp.prettier-vscode",
        "eamodio.gitlens"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "files.autoSave": "afterDelay",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  },

  "forwardPorts": [5000, 8080],
  "portsAttributes": {
    "5000": {
      "label": "Flask App",
      "onAutoForward": "openPreview"
    },
    "8080": {
      "label": "SQLite Web GUI",
      "onAutoForward": "openPreview"
    }
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y sqlite3 git-lfs && git lfs install && pip install --upgrade pip && pip install flask flask-login python-dotenv requests sqlite-web openai google-genai groq",

  "remoteUser": "vscode"
}